cabal-version:      3.0
name:               arc-model
version:            0.1.0.0
synopsis:           Independent semantic model of arc authorization
description:
  A pure Haskell characterization of arc's authorization semantics: what a
  recorded history permits, what it refuses, and which facts a decision
  rests on. The model is independent of the Rust implementation; it is not
  a port of it.
license:            Unlicense
author:             arc contributors
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:
    Arc.Model
    Arc.Model.Audit
    Arc.Model.Basis
    Arc.Model.Debt
    Arc.Model.Decision
    Arc.Model.History
    Arc.Model.Identifiers
    Arc.Model.Observation
  build-depends:
    base >=4.21 && <5,
    containers >=0.7 && <0.8
  default-language: Haskell2010
  ghc-options:      -Wall

test-suite spec
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  other-modules:
    Fixtures
    Generators
    Mutants
    Render
  build-depends:
    base >=4.21 && <5,
    containers >=0.7 && <0.8,
    arc-model,
    QuickCheck >=2.14 && <2.16
  default-language: Haskell2010
  ghc-options:      -Wall
